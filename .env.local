# Exemplo: PenEcho usando uma LLM LOCAL (LM Studio) via Tailscale.
# Copie para .env e ajuste os valores marcados com <...>:
#   cp .env.local .env

AI_PROVIDER=api
AI_API_FORMAT=openai

# IP do host do LM Studio. Use o IP IPv4 DIRETO (nao o hostname):
# o fetch do Node prefere IPv6 e o LM Studio so escuta em IPv4 -> ECONNREFUSED.
# Descubra com:  tailscale ip <nome-do-host>   (ex.: tailscale ip m4book)
AI_API_URL=http://<SEU_IP_TAILSCALE>:1234/v1

# ID exato do modelo carregado. Confira:  curl http://<IP>:1234/v1/models
# Tem que ser um modelo de VISAO (vlm).
AI_API_MODEL=qwen/qwen3.5-9b

# LM Studio ignora, mas o campo e obrigatorio.
AI_API_KEY=lm-studio

# LM Studio NAO aceita "max". Validos: none|minimal|low|medium|high|xhigh
# none = sem "pensar" antes: ~2x mais rapido, ideal pra board de desenho.
AI_EFFORT=none

# webp NAO e lido pelo vision do llama.cpp -> use jpeg (ou png).
PENECHO_AI_IMAGE_FORMAT=jpeg

# Forca o idioma de leitura e resposta (ex.: Portuguese, English, Spanish).
# Vazio = detecta sozinho pelo conteudo. Use quando o modelo se perde no idioma.
AI_LANGUAGE=Portuguese

# answer     = responde/explica/plota (padrao)
# transcribe = so converte sua letra em texto digitado (apaga a tinta, escreve no lugar)
AI_MODE=answer

# 0.0.0.0 = aceita a rede/Tailscale. Acesse do tablet em http://<IP-desta-maquina>:3888
HOST=0.0.0.0
PORT=3888

# Dica: no LM Studio, desligue o auto-unload/idle-TTL do modelo,
# senao o primeiro request depois de ocioso recarrega e estoura o timeout (504).
